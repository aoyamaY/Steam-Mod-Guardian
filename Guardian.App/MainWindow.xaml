<Window x:Class="Guardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Steam Mod Guardian · 2.1.0" Icon="Assets/AppIcon.png"
        Width="1500" Height="850" MinWidth="1000" MinHeight="650"
        WindowStyle="None" ResizeMode="CanResize" Background="#14181F" Foreground="#F2F5FA"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Color x:Key="Bg">#14181F</Color>
        <Color x:Key="Glass1">#6B222A34</Color>
        <Color x:Key="Glass2">#88313946</Color>
        <Color x:Key="Glass3">#AA11161E</Color>
        <Color x:Key="BorderColor">#66FFFFFF</Color>
        <Color x:Key="TextColor">#F2F5FA</Color>
        <Color x:Key="SubtleText">#B4C0CF</Color>
        <Color x:Key="Accent">#4DA2FF</Color>
        <Color x:Key="Accent2">#7FC7FF</Color>
        <Color x:Key="Good">#95D89B</Color>
        <Color x:Key="Warn">#F6C86D</Color>
        <Color x:Key="Danger">#FF7E87</Color>
        <Color x:Key="Unknown">#C0A8FF</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource Bg}"/>
        <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource Glass1}"/>
        <SolidColorBrush x:Key="GlassBrush2" Color="{StaticResource Glass2}"/>
        <SolidColorBrush x:Key="GlassBrush3" Color="{StaticResource Glass3}"/>
        <SolidColorBrush x:Key="BorderBrushGlass" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleText}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
        <SolidColorBrush x:Key="AccentBrush2" Color="{StaticResource Accent2}"/>
        <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource Warn}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
        <SolidColorBrush x:Key="UnknownBrush" Color="{StaticResource Unknown}"/>

        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#50242C37" Offset="0" />
            <GradientStop Color="#381A2029" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#62334055" Offset="0" />
            <GradientStop Color="#431E2530" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D54DA2FF" Offset="0" />
            <GradientStop Color="#B32F72D0" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="GlassBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Background" Value="{StaticResource CardGradient}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushGlass}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A7D8FF"/>
                                <Setter TargetName="Surface" Property="Opacity" Value="0.98"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E0F1FF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource PillButton}"/>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="BorderBrush" Value="#A6D7FF"/>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#70242C37"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#A7D8FF"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="6" Background="#5A202834" BorderBrush="#88FFFFFF" BorderThickness="1" Margin="0,0,8,0">
                                <Viewbox x:Name="Mark" Width="14" Height="14" Visibility="Collapsed"><Canvas Width="24" Height="24"><Path Data="M20,6 L9,17 L4,12" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#CC4DA2FF"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#B7E0FF"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.35"/>
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" Margin="4,2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#554DA2FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#884DA2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#70242C37"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="DropSurface" Background="#70242C37" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="12">
                                    <Viewbox Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"><Canvas Width="24" Height="24"><Path Data="M6,9 L12,15 L18,9" Stroke="#E8F2FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
                                </Border>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropSurface" Property="BorderBrush" Value="#A7D8FF"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="12,0,34,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#E01D2430" BorderBrush="#77FFFFFF" BorderThickness="1" CornerRadius="12" Padding="5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="DropToggle" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#70242C37"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#66FFFFFF"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#22FFFFFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#554DA2FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#332A3442"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><Grid x:Name="PART_Track" ClipToBounds="True"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"/></Grid></Border></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="InvisiblePage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#20161C26"/><Setter Property="Width" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
                        <Track.DecreaseRepeatButton><RepeatButton x:Name="PageBack" Style="{StaticResource InvisiblePage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Background="#88B5D6F7"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton x:Name="PageForward" Style="{StaticResource InvisiblePage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="PageBack" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="PageForward" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="RowHeight" Value="34"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#352E3946"/>
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#6A4DA2FF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#28FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#36FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RiskText" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="6,0"/><Setter Property="VerticalAlignment" Value="Center"/><Style.Triggers>
            <DataTrigger Binding="{Binding RiskLabel}" Value="极高风险"><Setter Property="Foreground" Value="#FF8D96"/></DataTrigger>
            <DataTrigger Binding="{Binding RiskLabel}" Value="高风险"><Setter Property="Foreground" Value="#FF8D96"/></DataTrigger>
            <DataTrigger Binding="{Binding RiskLabel}" Value="需复核"><Setter Property="Foreground" Value="#F6C86D"/></DataTrigger>
            <DataTrigger Binding="{Binding RiskLabel}" Value="未完成/未知"><Setter Property="Foreground" Value="#C0A8FF"/></DataTrigger>
            <DataTrigger Binding="{Binding RiskLabel}" Value="未发现风险"><Setter Property="Foreground" Value="#95D89B"/></DataTrigger>
        </Style.Triggers></Style>
        <Style x:Key="DownloadText" TargetType="TextBlock"><Setter Property="Margin" Value="6,0"/><Setter Property="VerticalAlignment" Value="Center"/><Style.Triggers>
            <DataTrigger Binding="{Binding DownloadLabel}" Value="直接文件下载 API"><Setter Property="Foreground" Value="#FF8D96"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
            <DataTrigger Binding="{Binding DownloadLabel}" Value="疑似下载落盘"><Setter Property="Foreground" Value="#F6C86D"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
            <DataTrigger Binding="{Binding DownloadLabel}" Value="联网+写入（待核实）"><Setter Property="Foreground" Value="#F6C86D"/></DataTrigger>
        </Style.Triggers></Style>
        <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource CardGradient}"/><Setter Property="Padding" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="TileSurface" CornerRadius="18" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileSurface" Property="BorderBrush" Value="#A7D8FF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TileSurface" Property="BorderBrush" Value="#E0F1FF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="TileSurface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="Tag" Value="active"><Setter TargetName="TileSurface" Property="Background" Value="#664DA2FF"/><Setter TargetName="TileSurface" Property="BorderBrush" Value="#A6D7FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="AcrylicSurface" Background="#14181F" CornerRadius="14" BorderThickness="0"><Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="12,8,12,6" Style="{StaticResource GlassBorderStyle}" Padding="12,5" Background="#6C1B212B">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Image Source="Assets/AppIcon.png" Width="38" Height="38" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel>
                        <TextBlock Text="Steam Mod Guardian" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="模组安全卫士 · 2.1.0" FontSize="11.5" Foreground="{StaticResource SubtleBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="使用指南" Style="{StaticResource PillButton}" Margin="0,0,10,0" Padding="12,6" Click="Help_Click"/>
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" ToolTip="最小化" AutomationProperties.Name="最小化" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化 / 还原" Click="MaxRestore_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}" ToolTip="关闭" AutomationProperties.Name="关闭" Click="CloseWindow_Click" Background="#70A13A45"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="265" MinWidth="215"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="315" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GlassBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="快速开始" Style="{StaticResource SectionTitle}"/>
                        <Button x:Name="RecommendedBtn" Content="一键推荐扫描" Style="{StaticResource PrimaryButton}" Click="Recommended_Click" Padding="10,13" Margin="0,0,0,8"/>
                        <TextBlock Text="自动选择已识别的模组目录，或使用当前范围。只检查，不运行、不删除文件。" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <TextBlock Text="扫描范围" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="GameLabel" Text="尚未选择游戏" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="选择需要检查的游戏" Style="{StaticResource PrimaryButton}" Click="Games_Click"/>
                            <Button Content="检查整个本地游戏库" Style="{StaticResource PillButton}" Click="AllGames_Click"/>
                            <Button x:Name="DetectBtn" Content="刷新 Steam 游戏库" Style="{StaticResource PillButton}" Click="Detect_Click"/>
                        </WrapPanel>

                        <Button Content="高级设置 / 模组目录" Click="Advanced_Click" Margin="0,6,0,6"/>
                        <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
                        <TextBlock Text="当前扫描目录（每行一个；可添加额外本地 Mod 目录）" Style="{StaticResource SectionTitle}" Margin="0,8,0,8"/>
                        <TextBox x:Name="RootsBox" Height="122" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" TextChanged="Roots_Changed" ToolTip="每行一个目录。若只用 Steam 工坊，可保持默认。"/>
                        <Button x:Name="AddBtn" Content="添加本地 Mod 目录" Style="{StaticResource PillButton}" Click="Add_Click"/>

                        </StackPanel>
                        <TextBlock Text="扫描控制" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
                        <WrapPanel>
                            <Button x:Name="ScanBtn" Content="开始扫描（推荐）" Style="{StaticResource PrimaryButton}" Click="Scan_Click" ToolTip="对当前已选游戏和目录进行安全扫描。"/>
                            <Button x:Name="CancelBtn" Content="取消当前任务" Style="{StaticResource PillButton}" IsEnabled="False" Click="Cancel_Click"/>
                            <Button Content="安全检查后启动游戏" Style="{StaticResource PillButton}" Click="Launch_Click" ToolTip="仅通过本工具发起启动，并在启动前做完整复查。"/>
                            <Button Content="保存当前游戏配置" Style="{StaticResource PillButton}" Click="SaveProfile_Click"/>
                        </WrapPanel>

                        <CheckBox x:Name="AmsiBox" Content="增强检测：Windows 防病毒引擎" IsChecked="False" Checked="AmsiConsent_Click" Unchecked="AmsiDisabled_Click" ToolTip="需主动同意；系统安全提供程序可能按策略进行云查询或提交样本。"/>
                        <TextBlock x:Name="AmsiText" Text="AMSI 未启用" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="26,0,0,6"/>
                        <CheckBox x:Name="ForceBox" Content="忽略缓存，完整重新分析（更慢，但更稳妥）"/>
                        <CheckBox x:Name="MonitorBox" Content="每 60 秒检查更新（适合盯工坊自动更新）"/>
                        <CheckBox x:Name="TitleBox" Content="在线查询工坊标题（只发送工坊 ID）" IsChecked="False"/>

                        <TextBlock Text="更多工具" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
                        <WrapPanel>
                            <Button Content="运行时观察" Style="{StaticResource PillButton}" Click="Runtime_Click"/>
                            <Button Content="隔离库" Style="{StaticResource PillButton}" Click="Vault_Click"/>
                            <Button Content="更新记录" Style="{StaticResource PillButton}" Click="History_Click"/>
                            <Button Content="打开配置目录" Style="{StaticResource PillButton}" Click="Config_Click"/>
                        </WrapPanel>

                        <Button x:Name="QuickYaraBtn" Content="一键下载并启用 YARA" Style="{StaticResource PrimaryButton}" Click="QuickYara_Click" ToolTip="从官方 GitHub 下载，校验 SHA-256 后安装并测试内置规则；不上传 Mod。"/>
                        <TextBlock x:Name="YaraText" Text="YARA 未启用" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <Button Content="高级检测工具" Click="Tools_Click" Margin="0,6,0,6"/>
                        <StackPanel x:Name="ToolsPanel" Visibility="Collapsed">
                        <TextBlock Text="检测与信誉" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
                        <WrapPanel>
                            <Button x:Name="YaraBtn" Content="配置 YARA" Style="{StaticResource PillButton}" Click="Yara_Click"/>
                            <Button x:Name="SyncBtn" Content="同步签名社区名单" Style="{StaticResource PillButton}" Click="Sync_Click"/>
                            <Button Content="本地哈希名单" Style="{StaticResource PillButton}" Click="Blacklist_Click"/>
                            <Button Content="本地域名名单" Style="{StaticResource PillButton}" Click="Domains_Click"/>
                            <Button Content="配置 YARA-X" Click="YaraX_Click" Style="{StaticResource PillButton}"/><Button Content="本地专业分析…" Click="LocalTools_Click" Style="{StaticResource PillButton}"/><Button Content="VirusTotal 信誉查询" Style="{StaticResource PillButton}" Click="Reputation_Click"/>
                        </WrapPanel>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Background="Transparent"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                    <Button x:Name="TileAllButton" Style="{StaticResource TileButton}" Click="TileAll_Click" ToolTip="点击筛选：全部结果">
                        <StackPanel>
                            <TextBlock Text="已扫描文件" TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}"/>
                            <TextBlock x:Name="TotalTile" Text="—" FontSize="28" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TileRiskButton" Style="{StaticResource TileButton}" Click="TileRisk_Click" ToolTip="点击筛选：高危及极高风险">
                        <StackPanel>
                            <TextBlock Text="高危 / 极高" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock x:Name="RiskTile" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TileDownloadButton" Style="{StaticResource TileButton}" Click="TileDownload_Click" ToolTip="点击筛选：直接/疑似文件下载">
                        <StackPanel>
                            <TextBlock Text="文件下载线索" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"/>
                            <TextBlock x:Name="DownloadTile" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TileUnknownButton" Style="{StaticResource TileButton}" Click="TileUnknown_Click" Margin="0" ToolTip="点击筛选：未完成 / 未知">
                        <StackPanel>
                            <TextBlock Text="未知 / 未完成" TextWrapping="Wrap" Foreground="{StaticResource UnknownBrush}"/>
                            <TextBlock x:Name="UnknownTile" Text="—" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource UnknownBrush}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Border Grid.Row="1" Style="{StaticResource GlassBorderStyle}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="搜索游戏、Mod、文件或域名" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                        <DockPanel><Button Content="清空" DockPanel.Dock="Right" Click="ClearSearch_Click" Margin="6,0,0,6"/><TextBox x:Name="SearchBox" TextChanged="Search_Changed" Margin="0,0,0,6" AutomationProperties.Name="搜索结果"/></DockPanel>
                        <WrapPanel><ComboBox x:Name="FilterBox" Width="190" Margin="0,0,8,6" SelectedIndex="0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="全部"/><ComboBoxItem Content="防病毒引擎检出"/><ComboBoxItem Content="内部可执行内容"/><ComboBoxItem Content="高危及极高风险"/>
                            <ComboBoxItem Content="直接/疑似文件下载"/>
                            <ComboBoxItem Content="有网络行为"/>
                            <ComboBoxItem Content="新增/更新"/>
                            <ComboBoxItem Content="共享 IL 指纹"/>
                            <ComboBoxItem Content="极高风险"/>
                            <ComboBoxItem Content="高风险"/>
                            <ComboBoxItem Content="需复核"/>
                            <ComboBoxItem Content="未完成/未知"/>
                            <ComboBoxItem Content="未发现风险"/>
                            <ComboBoxItem Content="含域名线索"/>
                            <ComboBoxItem Content="原生 PE"/>
                            <ComboBoxItem Content="脚本"/>
                        </ComboBox><Button Content="高危" Click="HighFilter_Click"/><Button Content="文件下载" Click="DownloadFilter_Click"/><Button x:Name="ExportBtn" Content="导出报告" Click="Export_Click" IsEnabled="False"/><Button Content="扫描警告" Click="Warnings_Click"/></WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource GlassBorderStyle}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="Counts" Text="等待扫描" TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}" Margin="8,4,8,8"/>
                        <DataGrid x:Name="Results" Grid.Row="1" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="Results_Changed" ItemsSource="{x:Null}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="风险" Binding="{Binding RiskLabel}" ElementStyle="{StaticResource RiskText}" Width="110"/>
                                <DataGridTextColumn Header="Mod 名称" Binding="{Binding Mod}" Width="180"/>
                                <DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="120"/>
                                <DataGridTextColumn Header="下载行为" Binding="{Binding DownloadLabel}" ElementStyle="{StaticResource DownloadText}" Width="160"/>
                                <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="130"/>
                                <DataGridTextColumn Header="变化" Binding="{Binding Change}" Width="82"/>
                                <DataGridTextColumn Header="来源" Binding="{Binding NameSource}" Width="90"/>
                                <DataGridTextColumn Header="工坊 ID" Binding="{Binding WorkshopId}" Width="104"/>
                                <DataGridTextColumn Header="防病毒引擎" Binding="{Binding AmsiLabel}" Width="170"/>
                                <DataGridTextColumn Header="域名线索" Binding="{Binding HostLabel}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="280">
                            <ContentControl x:Name="EmptyIcon" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock x:Name="EmptyTitle" Text="还没有扫描结果" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyHint" Text="点击左侧“一键推荐扫描”，开始检查模组。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource SubtleBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Background="Transparent"/>

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource GlassBorderStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="当前选中项" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="SelectionTitle" Text="选中一行查看证据" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="RiskExplanation" Text="选中结果后，会显示风险含义和推荐操作。" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button x:Name="QuarantineBtn" Content="隔离高危文件" Style="{StaticResource PillButton}" BorderBrush="#AAFF7E87" Click="Quarantine_Click" IsEnabled="False"/>
                            <Button x:Name="WorkshopBtn" Content="打开工坊页面" Style="{StaticResource PillButton}" Click="Workshop_Click" IsEnabled="False"/>
                            <Button x:Name="HashBtn" Content="复制 SHA-256" Style="{StaticResource PillButton}" Click="CopyHash_Click" IsEnabled="False"/>
                            <Button x:Name="EvidenceBtn" Content="导出举报证据" Style="{StaticResource PillButton}" Click="Evidence_Click" IsEnabled="False"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource GlassBorderStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="看不懂时，先记住这 3 条" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="红色：优先人工复核。确认恶意后取消订阅或隔离。" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="黄色：需复核；紫色：未完成或未知。均不代表安全。" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="绿色：未发现风险，不等于安全。" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource GlassBorderStyle}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="检测证据" Style="{StaticResource SectionTitle}" Margin="2,0,2,8"/>
                        <TextBox x:Name="Details" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#52232A34" BorderBrush="#48FFFFFF"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Margin="12,0,12,12" Style="{StaticResource GlassBorderStyle}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="Status" Text="准备就绪。正在自动识别 Steam 游戏库。" TextWrapping="Wrap"/>
                    <TextBlock Text="本工具仅提供风险线索，不执行被检测的模组，也不保证绝对安全。" Foreground="{StaticResource SubtleBrush}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="TaskProgressPanel" Grid.Column="1" Width="260" Margin="18,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock x:Name="TaskProgressLabel" Text="正在检查" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,6"/><ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="10" Value="0"/></StackPanel>
            </Grid>
        </Border>
    </Grid></Border>
</Window>
